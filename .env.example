# ── Next.js app (app/api/analyze/route.ts) ────────────────────────────────
# Anthropic API key — get one at https://platform.claude.com
# Used server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# ── Standalone app (netlify/functions/analyze.mjs) ────────────────────────
# Set these in Netlify → Site configuration → Environment variables, NOT here.
# The function picks NVIDIA when NVIDIA_API_KEY is present, otherwise Anthropic.
#
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct   # must be vision-capable
# NVIDIA_JSON_MODE=off                              # off | json_object | json_schema
# AI_PROVIDER=nvidia                                # force one when both keys are set
